Config.Lootbox = {
    {Weight=55, Kind="Cash", Amount=100},
    {Weight=25, Kind="Cash", Amount=500},
    {Weight=12, Kind="Cash", Amount=2500},
    {Weight=6, Kind="XP", Amount=1000},
    {Weight=2, Kind="Jackpot", Amount=25000}
