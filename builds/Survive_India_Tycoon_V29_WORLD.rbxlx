local function fmtWait(sec)
    sec=math.max(0,math.floor(sec or 0))
    if sec&lt;=0 then return "READY TO CLAIM" end
    local h=math.floor(sec/3600) local m=math.floor((sec%3600)/60)
    if h&gt;0 then return h.."h "..m.."m" end
    return m.."m"
end

